# Alum Metal Arak — Apache / cPanel rules for the static web app.
# Upload this file next to index.html (usually public_html/ or public_html/app/).

DirectoryIndex index.html

<IfModule mod_headers.c>
  # index.html carries the ?v= query for styles.css / app.js, so it must always be
  # revalidated with the server. Without this rule a returning visitor can be kept on
  # an old shell and would never see the in-app update popup.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
